{
  "connections": [
    {
      "name": "context7",
      "title": "Docs lookup",
      "purpose": "Current documentation and code examples for a named library, from the public Context7 service.",
      "url": "https://mcp.context7.com/mcp",
      "credential": "none",
      "roles": [
        "scout",
        "developer",
        "architect"
      ],
      "tools": {
        "resolve-library-id": "read",
        "query-docs": "read"
      }
    },
    {
      "name": "github",
      "title": "GitHub",
      "purpose": "Read pull requests, checks, job logs, issues and repository files on GitHub, read-only.",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "credential": "den",
      "headers": {
        "X-MCP-Toolsets": "pull_requests,actions,issues,repos"
      },
      "roles": [
        "orchestrator",
        "qa",
        "security",
        "developer",
        "scout"
      ],
      "tools": {
        "pull_request_read": "read",
        "list_pull_requests": "read",
        "search_pull_requests": "read",
        "actions_get": "read",
        "actions_list": "read",
        "get_job_logs": "read",
        "issue_read": "read",
        "list_issues": "read",
        "search_issues": "read",
        "get_file_contents": "read",
        "list_commits": "read",
        "get_commit": "read",
        "list_branches": "read",
        "search_code": "read"
      }
    },
    {
      "name": "den",
      "title": "The den",
      "purpose": "Bao's hands on the den: resolve, comment on and file tickets, and start a delivery the user asked for.",
      "script": "apps/bridge/library/servers/den.mjs",
      "credential": "run",
      "roles": [
        "orchestrator"
      ],
      "tools": {
        "board_resolve": "board",
        "board_comment": "board",
        "board_file": "change",
        "start_delivery": "change"
      }
    }
  ]
}
