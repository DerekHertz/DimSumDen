# The den's bridge as a systemd user service (ADR 0026 decision 4). `npm run den:install` fills the @...@ marks from this
# machine and writes the result to ~/.config/systemd/user/den.service; nothing else writes it, and no agent or bridge route may.
[Unit]
Description=Dim Sum Den bridge

[Service]
Type=simple
Slice=den.slice
WorkingDirectory=@CHECKOUT@
ExecStart=@NODE@ @STATE@/bridge/current/apps/bridge/server.mjs
Environment=PORT=4317
Environment=DEN_STATE_DIR=@STATE@
Environment="PATH=@PATH@"
Restart=on-failure
SuccessExitStatus=143
RestartSec=2

[Install]
WantedBy=default.target
